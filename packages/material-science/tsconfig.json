{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"rootDir": "src",
		"outDir": "dist",
		"declaration": true
	},
	"include": ["src/*.ts"]
}
