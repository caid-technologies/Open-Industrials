# Replace this hostname with a domain pointing at your server before enabling.
runtime.example.com {
    # Provision accounts over loopback/SSH only, even when signup is enabled.
    @registration path /auth/register
    respond @registration 404

    reverse_proxy 127.0.0.1:8791 {
        health_uri /health
        health_interval 10s
        health_timeout 3s
        health_status 200
        transport http {
            dial_timeout 3s
            response_header_timeout 15s
        }
    }
    # No access log: request credentials and bodies must not be logged.
}
