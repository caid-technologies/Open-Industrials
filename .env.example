# Optional: override the Python executable (defaults to .venv, then python).
# FORM_PYTHON=C:\path\to\python.exe
# Provider credentials are read by the server-side Form process only.
# OPENAI_API_KEY=
# LLM_PROVIDER=openai
# LLM_MODEL=your-model-id
PORT=8787
# Optional local adapter endpoint. Mergence always saves feedback under .astra/feedback;
# this forwards the same package only when an explicit adapter is configured.
# FORM_FEEDBACK_URL=http://127.0.0.1:8000/api/astra/feedback
# Optional fixed callback used by `astra auth login`.
# ASTRA_CLI_REDIRECT_URL=http://127.0.0.1:54331/callback

# Public browser configuration. Never use a service-role or secret key here.
VITE_SUPABASE_URL=https://mrhxfmtofvrgfaikllfw.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Set false for browser-only deployments (Form generation runs separately).
VITE_FORM_GENERATION_ENABLED=true
# Optional binary storage; Postgres/Auth and the device library work without it.
VITE_CLOUD_STORAGE_ENABLED=false

# Optional external-agent scene authoring through the local stdio MCP server.
# Uses `astra auth login`; never put a user token in an agent's tool arguments.
ASTRA_SCENE_TOOLS_ENABLED=false
ASTRA_WORKBENCH_ORIGIN=http://127.0.0.1:5173

# Independent SQLite game runtime; no Supabase configuration is used by game tools.
ASTRA_GAME_TOOLS_ENABLED=false
ASTRA_GAME_SERVICE_URL=http://127.0.0.1:8790
ASTRA_GAME_PORT=8790
ASTRA_GAME_DB=.astra/game/runtime.sqlite
ASTRA_GAME_ALLOW_SIGNUP=false
# ASTRA_GAME_SESSION is a per-account opaque session, supplied server-side by tower-defense.

# Persistent scene MCP backend: supabase (default) or local (no cloud/login).
# ASTRA_SCENE_TOOLS_ENABLED=true
# ASTRA_SCENE_BACKEND=local
# Relative to ASTRA_ROOT for MCP, current directory for the local scene CLI.
# ASTRA_SCENE_DATA_DIR=.astra/scenes
